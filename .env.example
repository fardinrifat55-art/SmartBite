# Database Configuration (SQLite via Prisma)
DATABASE_URL="file:./db/custom.db"

# AI Multimodal Vision & Grocery Planner API Keys
# The app works out-of-the-box with free keyless fallback & local heuristics.
# For high-speed dedicated limits, supply one or more of the following:

# 1. Google Gemini (Recommended for Bangladesh regional meal understanding & grocery intelligence)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# 2. Groq Vision (Llama-4 Scout & Llama 3)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=""

# 3. OpenRouter (Multi-model router)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Optional Model Overrides
GEMINI_MODEL="gemini-flash-lite-latest"
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
